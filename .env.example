# Supabase (Offre gratuite - Free Tier sans carte bancaire)
# À récupérer sur https://supabase.com dans les paramètres API de votre projet
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Moteur Suno AI v3.5 / v4 (Chant et Voix Humaines Réelles)
# Passerelle développeur Suno (ex: aimusicapi.ai ou apiframe.ai)
SUNO_API_KEY=
SUNO_API_URL=https://api.aimusicapi.ai/api/v1/sonic

# Hugging Face Inference API (Offre gratuite disponible sur https://huggingface.co)
# Utilisé pour Meta MusicGen (production instrumentale)
HUGGINGFACE_API_KEY=

# Google Lyria (DeepMind) : à renseigner dès que l'API officielle est disponible
GOOGLE_LYRIA_API_KEY=
